{
  "name": "lumo-worker",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "wrangler dev | npx pino-pretty",
    "dev-remote": "wrangler dev --remote  | npx pino-pretty",
    "deploy": "wrangler deploy --minify",
    "start": "node ./dist/src/index.js",
    "db:generate:d1": "npx drizzle-kit generate --config=drizzle-d1.config.ts",
    "db:migrate:d1:local": "wrangler d1 migrations apply lumo-db --local",
    "db:migrate:d1:remote": "wrangler d1 migrations apply lumo-db --remote",
    "wrangler:types": "wrangler types",
    "dev:setup": "chmod +x scripts/dev-setup.sh && ./scripts/dev-setup.sh",
    "test:api": "chmod +x scripts/test-api.sh && ./scripts/test-api.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "npm run lint --fix",
    "build": "tsc && tsc-alias"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@hono/zod-openapi": "^1.6.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "@scalar/hono-api-reference": "^0.12.17",
    "better-auth": "^1.7.16",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "hono-pino": "^0.10.3",
    "pino": "^10.4.0",
    "stoker": "^2.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@cloudflare/workers-types": "^4.20251014.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "esbuild-plugin-path-alias": "^1.0.7",
    "eslint": "^9.39.0",
    "eslint-plugin-format": "^1.0.2",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.157.0"
  }
}